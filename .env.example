# ==============================================================================
# NEXORA - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env on your local machine:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# DO NOT COMMIT YOUR LOCAL .env FILE TO GIT.
# ==============================================================================

# Application Environment (development / production / testing)
ENVIRONMENT=development

# Server Network Binding
# 0.0.0.0 binds to all network interfaces (localhost + local WiFi/LAN)
HOST=0.0.0.0
PORT=8000

# Database Connection URL
# SQLite default for local development. For production PostgreSQL:
# postgresql://user:password@hostname:5432/nexora_db
DATABASE_URL=sqlite:///./nexora.db

# JWT Authentication & Cryptographic Security
# In production, generate a strong random token: openssl rand -hex 32
SECRET_KEY=nexora-secret-jwt-encryption-key-v1-coimbatore-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Geolocation & Tactical Emergency Geofencing
# SOS_RADIUS_KM defines the tactical coverage radius around emergencies (Coimbatore metro = 35.0 km)
SOS_RADIUS_KM=35.0
STOP_RADIUS_METRES=40.0
GPS_UPDATE_INTERVAL=3
BUS_OFFLINE_TIMEOUT=30
